    { "type": "justify", "ground": "light", "transition": "cut", "props": { "lines": ["Less", "waiting", "*more*", "shipping"] } },
    { "type": "timeline", "ground": "dark", "transition": "wipe", "props": { "title": "Our story", "items": [{"label":"2021","text":"Two founders, one CLI"},{"label":"2023","text":"10,000 teams"},{"label":"2026","text":"Every Fortune 500"}] } },
